# Local-development configuration template. Do not place credentials in this file.
# Copy to .env.local and use only synthetic/local-development values.
#
# The approved Slice 1 boundary has no hosting, managed database, managed auth,
# deployment, production credentials, or customer/personal data.

# Application
NEXT_PUBLIC_APP_NAME="Mini Project Management"

# Reserved local-service configuration. These values are intentionally blank:
# provisioners must not commit connection strings, credentials, or tokens.
DATABASE_URL=""
SESSION_SECRET=""
LOCAL_EMAIL_CAPTURE_URL=""
